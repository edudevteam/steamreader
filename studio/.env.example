# R2 API token for the steamreader bucket, used to publish content and upload
# images. Create it under R2 -> Manage API tokens, with Object Read & Write on
# the steamreader bucket only. Copy this file to .env and fill it in.
#
# These stay on this machine: only the Studio's local server reads them, and
# the browser tab never sees them.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=steamreader
R2_PUBLIC_BASE_URL=https://cdn.steamreader.com
